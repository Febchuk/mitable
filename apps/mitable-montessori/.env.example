NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
ANTHROPIC_API_KEY=
# Gemini powers the teacher chat agent ("Ask Mitable"). Get a key at
# https://aistudio.google.com/apikey
GEMINI_API_KEY=
NEXT_PUBLIC_APP_NAME=mitable-montessori

# Local MCP server for Codex and Claude. This is a school-scoped external API
# key created in Admin → API Keys; never commit a real key.
MITABLE_API_BASE_URL=https://www.mitable.ng/api/public/v1
MITABLE_API_KEY=

# Speech + OCR capture worker (Whisper / Tesseract in capture.worker.ts). Required for voice notes on new reports.
NEXT_PUBLIC_ENABLE_CAPTURE_WORKER=1

# Teacher-invite emails (Resend). Without this, /api/admin/teachers/invite will reject sends.
RESEND_API_KEY=
# From address. Defaults to onboarding@resend.dev (only delivers to your Resend account email).
# Once you verify a domain in Resend, set: RESEND_FROM="Mitable <noreply@yourdomain.com>"
RESEND_FROM=

# Public origin used to build invite links in outbound emails. Falls back to the request Origin if unset.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# When "1", teachers land on Reports with report-first nav (hero list). Default off → Progress home.
NEXT_PUBLIC_REPORT_FIRST_EXPERIENCE=0

# When "1", restores the Today route and the global Ask Mitable chatbot.
NEXT_PUBLIC_ADD_TODAY_PROGRESS_AND_AGENT=0

# When "1", teachers get the Gemini "Ask Mitable" chat agent (mark attendance,
# record progress/grades, log observations, create/edit reports) on the mobile
# FAB and desktop dock. Independent of the Today route above. Needs GEMINI_API_KEY.
NEXT_PUBLIC_TEACHER_CHAT_AGENT=1

# When "1", admins see the school-wide Today page (default home). Off → Classrooms home.
NEXT_PUBLIC_ADMIN_TODAY=0

# When "1", enables in-class group teams on Progress (teacher) and Groups UI (admin).
NEXT_PUBLIC_CLASSROOM_GROUPS=0

# When "1", shows program assignment on admin Classrooms (Montessori / IEP / Speech).
NEXT_PUBLIC_CLASSROOM_PROGRAMS=0

# When "1", admins can edit report templates under Admin → Templates.
NEXT_PUBLIC_ADMIN_REPORT_TEMPLATES=0

# When "1", AI scores reports on submit/edit (confidence UI in the reports rail).
NEXT_PUBLIC_REPORT_AI_SCORING=0
